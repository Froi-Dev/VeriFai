# Docker Desktop configuration. Generate .env with docker/prepare_env.py.
POSTGRES_PASSWORD=replace_with_random_hex
JWT_SECRET=replace_with_at_least_32_random_characters
GEMINI_API_KEYS=
GEMINI_TEXT_DETECTION_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
NEWS_FAST_MODEL=gemini-3.5-flash-lite
SERPER_API_KEYS=
SEARCHAPI_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=
NEWS_SEARCH_PROVIDER_ORDER=serper,searchapi,google
# Optional local-model override. Copy the complete checkpoint to models/text,
# or set a host path here when using compose.local-model.yaml.
# TEXT_MODEL_HOST_PATH=C:/Users/your-name/Downloads/xlmr-ai-human-v11-latest-gen
# Optional real SMTP server; otherwise emails appear at localhost:8025.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=
