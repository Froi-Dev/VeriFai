# Copy to .env and replace every CHANGE_ME value. Never commit .env.
DATABASE_URL=postgresql+psycopg://verifai_app:CHANGE_ME@localhost:5432/verifaiDb?sslmode=disable
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_TOKEN_REUSE_GRACE_SECONDS=15
SESSION_IDLE_EXPIRE_HOURS=24
MAX_ACTIVE_SESSIONS=10

ENVIRONMENT=development
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Production requires a Fernet key and Redis-backed rate limiting.
# Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DATA_ENCRYPTION_KEY=CHANGE_ME
RATE_LIMIT_STORAGE_URI=memory://
# Production can reuse RATE_LIMIT_STORAGE_URI when RESULT_CACHE_URL is blank.
RESULT_CACHE_URL=
RESULT_CACHE_MAX_ENTRIES=1000
TEXT_RESULT_CACHE_SECONDS=3600
NEWS_RESULT_CACHE_SECONDS=600
IMAGE_RESULT_CACHE_SECONDS=600

PASSWORD_RESET_EXPIRE_MINUTES=20
FRONTEND_RESET_URL=http://localhost:5173/auth/reset

# Required for password-reset delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# Local Hugging Face sequence-classification model used by POST /api/v1/detector/text.
TEXT_MODEL_PATH=C:\Users\dever\Downloads\xlmr-ai-human-best
TEXT_MODEL_DEVICE=auto
# Leave blank when config.json names both labels. For legacy exports, set this
# only after confirming the training label mapping (0 or 1).
# TEXT_MODEL_AI_LABEL_ID=1
TEXT_MODEL_MAX_LENGTH=512
TEXT_MODEL_STRIDE=64
TEXT_MODEL_BATCH_SIZE=4
TEXT_MODEL_MAX_CONCURRENT_INFERENCES=2
TEXT_MODEL_WARMUP=false
TEXT_MODEL_REVIEW_THRESHOLD=0.65
TEXT_ANALYSIS_DEADLINE_SECONDS=30
RATE_LIMIT_TEXT_DETECTION=10/minute
RATE_LIMIT_IMAGE_DETECTION=6/minute

# Fake News Analyzer search credentials are backend-only. Configure at least one provider.
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=
SEARCHAPI_API_KEY=
# Optional Google AI Mode discovery. Its generated summary is never proof;
# VeriFai only evaluates the cited reference links.
SEARCHAPI_AI_MODE_API_KEY=
SEARCHAPI_AI_MODE_MAX_QUERIES=1
SERPER_API_KEY=
SERPER_API_KEYS=
NEWS_SEARCH_PROVIDER_ORDER=google,searchapi,serper
FACT_CHECK_DOMAINS=verafiles.org,rappler.com,tsek.ph
QUOTE_SOURCE_DOMAINS=tribune.net.ph,smninewschannel.com
PHILIPPINE_NEWS_DOMAINS=abs-cbn.com,balita.net.ph,bilyonaryo.com,brigadanews.ph,bulatlat.com,businessmirror.com.ph,bworldonline.com,dailyguardian.com.ph,dailytribune.net.ph,davaotoday.com,dzrh.com.ph,gmanetwork.com,inquirer.net,journalnews.com.ph,malaya.com.ph,manilastandard.net,manilatimes.net,mb.com.ph,mindanews.com,news5.com.ph,onenews.ph,panaynews.net,philstar.com,pia.gov.ph,pna.gov.ph,pco.gov.ph,politiko.com.ph,rappler.com,remate.ph,smninewschannel.com,sunstar.com.ph,tribune.net.ph,tsek.ph,verafiles.org,coa.gov.ph,dbm.gov.ph,dilg.gov.ph,house.gov.ph,officialgazette.gov.ph,ovp.gov.ph,pnp.gov.ph,senate.gov.ph,dole.gov.ph,psa.gov.ph,bsp.gov.ph
TRUSTED_NEWS_DOMAINS=reuters.com,pna.gov.ph,gmanetwork.com,abs-cbn.com,inquirer.net,verafiles.org,tsek.ph
NEWS_TIER_2_DOMAINS=rappler.com,philstar.com,mb.com.ph,news5.com.ph,sunstar.com.ph,tribune.net.ph,apnews.com,afp.com,bbc.com
NEWS_MIN_RELEVANT_RESULTS=3
NEWS_RELEVANCE_THRESHOLD=40
NEWS_MAX_SEARCH_RESULTS=20
NEWS_MAX_ARTICLES_TO_SCRAPE=6
NEWS_MAX_CONCURRENT_SEARCH_REQUESTS=4
NEWS_MAX_CONCURRENT_SCRAPES=4
NEWS_MAX_EVIDENCE_ITEMS=8
NEWS_MAX_RELATED_EVIDENCE=3
NEWS_ANALYSIS_DEADLINE_SECONDS=35
NEWS_SEARCH_TIMEOUT_SECONDS=10
NEWS_SCRAPE_TIMEOUT_SECONDS=12
NEWS_MAX_ARTICLE_BYTES=2000000
NEWS_MAX_REDIRECTS=3
NEWS_OLD_STORY_DAYS=30
NEWS_UNRESTRICTED_FALLBACK=true
NEWS_DEBUG=false
RATE_LIMIT_NEWS_VERIFICATION=6/minute

# News-image OCR. PaddleOCR is primary; Gemini is only used for uncertain OCR.
IMAGE_OCR_MAX_BYTES=10000000
# Processing is bounded independently from the accepted source dimensions.
IMAGE_OCR_MAX_PIXELS=6000000
IMAGE_OCR_MAX_SOURCE_PIXELS=80000000
IMAGE_OCR_WARMUP=false
IMAGE_MAX_CONCURRENT_CLAIMS=2
IMAGE_ANALYSIS_DEADLINE_SECONDS=55
PADDLEOCR_LANGUAGE=en
OCR_MEDIUM_CONFIDENCE=0.75
OCR_HIGH_CONFIDENCE=0.90
# Comma-separated server-side key pool. GEMINI_API_KEY remains supported for
# deployments that only have one key.
GEMINI_API_KEYS=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_KEY_COOLDOWN_SECONDS=60
